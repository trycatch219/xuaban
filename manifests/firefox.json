{
  "manifest_version": 3,
  "name": "学伴 · 网页学习助手",
  "version": "0.4.0",
  "description": "选中文字、图片或视频画面，在侧栏中向自己的模型提问。",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "contextMenus"
  ],
  "optional_host_permissions": [
    "https://*/*",
    "http://localhost/*",
    "http://127.0.0.1/*"
  ],
  "background": {
    "scripts": [
      "background.js"
    ]
  },
  "action": {
    "default_title": "打开学伴并启用当前网页"
  },
  "sidebar_action": {
    "default_panel": "panel.html",
    "default_title": "学伴"
  },
  "options_ui": {
    "page": "panel.html#settings",
    "open_in_tab": true
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "xueban@local.example",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ],
        "optional": [
          "websiteContent"
        ]
      }
    }
  }
}
